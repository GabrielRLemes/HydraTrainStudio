#!/usr/bin/env bash
set -euo pipefail
repo='@REPO@'
tag='@TAG@'
sha='@SHA@'
payload=HydraTrainStudio-app.zip
here="$(cd "$(dirname "$0")" && pwd)"
tmp="$(mktemp -d)"
trap 'rm -f "$tmp/$payload" "$tmp/linux_setup.py"; rmdir "$tmp"' EXIT
archive="$tmp/$payload"
if [[ -f "$here/$payload" ]]; then cp -- "$here/$payload" "$archive"; fi
if ! { [[ -f "$archive" ]] && printf '%s  %s\n' "$sha" "$archive" | sha256sum --check --status; }; then
  [[ -n "$repo" ]] || { echo "Place $payload next to the installer."; exit 1; }
  curl --proto '=https' --proto-redir '=https' -fL --retry 3 "https://github.com/$repo/releases/download/$tag/$payload" -o "$archive"
fi
printf '%s  %s\n' "$sha" "$archive" | sha256sum -c -
python3 -c 'import sys, tkinter, venv; assert sys.version_info >= (3,11)' || {
  echo "Install Python 3.11 or later with Tk and venv, then run setup again." >&2; exit 1;
}
unzip -p "$archive" app/linux_setup.py > "$tmp/linux_setup.py"
python3 -B "$tmp/linux_setup.py" "$archive"
