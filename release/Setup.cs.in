using System;
using System.IO;
using System.IO.Compression;
using System.Net;
using System.Security.Cryptography;
using System.Diagnostics;
using System.Windows.Forms;
internal static class Setup {
    internal static readonly string LogPath = Path.Combine(Path.GetTempPath(), "HydraTrainStudio-install.log");
    static string stage = "Starting installer";
    static void Record(string message) {
        try { File.AppendAllText(LogPath, DateTime.UtcNow.ToString("o") + " " + message + Environment.NewLine); }
        catch (IOException) { }
        catch (UnauthorizedAccessException) { }
    }
    static bool MatchesPackage(string path) {
        using (var input = File.OpenRead(path))
        using (var hash = SHA256.Create())
            return BitConverter.ToString(hash.ComputeHash(input)).Replace("-","").ToLowerInvariant() == "@SHA@";
    }
    internal static void Install(System.Collections.Generic.Dictionary<string,string> choices, Action<string> report) {
        string temp = null;
        try {
            report("Preparing the application package...");
            Record("Installer @TAG@ started");
            string file = "HydraTrainStudio-app.zip";
            string repo = "@REPO@", tag = "@TAG@";
            string archive = Path.Combine(Path.GetDirectoryName(typeof(Setup).Assembly.Location), file);
            stage = "Locating application package";
            if (!File.Exists(archive) || (repo.Length != 0 && !MatchesPackage(archive))) {
                if (repo.Length == 0) throw new IOException("Place " + file + " next to this installer.");
                temp = Path.GetTempFileName();
                stage = "Downloading application package from GitHub";
                ServicePointManager.SecurityProtocol = SecurityProtocolType.Tls12;
                using (var client = new WebClient())
                    client.DownloadFile("https://github.com/" + repo + "/releases/download/" + tag + "/" + file, temp);
                archive = temp;
            }
            string root = Path.GetFullPath(choices["folder"]).TrimEnd(Path.DirectorySeparatorChar);
            if (Directory.Exists(root) && Directory.GetFileSystemEntries(root).Length != 0 &&
                !(File.Exists(Path.Combine(root,"app","inicio.py")) && File.Exists(Path.Combine(root,"Abrir.ps1"))))
                throw new IOException("Select an empty folder or an existing HydraTrainStudio installation.");
            Record("Destination: " + root);
            stage = "Verifying application package";
            using (var stream = File.OpenRead(archive)) {
                using (var hash = SHA256.Create())
                    if (BitConverter.ToString(hash.ComputeHash(stream)).Replace("-","").ToLowerInvariant() != "@SHA@")
                        throw new IOException("Package checksum verification failed.");
                stream.Position = 0;
                using (var zip = new ZipArchive(stream, ZipArchiveMode.Read)) {
                    foreach (string required in new [] { "HydraTrainStudio.exe", "Abrir.ps1", "app/inicio.py" })
                        if (zip.GetEntry(required) == null || zip.GetEntry(required).Length == 0)
                            throw new IOException("Required file missing from package: " + required);
                    foreach (var entry in zip.Entries) {
                        stage = "Extracting " + entry.FullName;
                        var dest = Path.GetFullPath(Path.Combine(root, entry.FullName));
                        if (!dest.StartsWith(root + Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase)) throw new IOException("Invalid package path.");
                        Directory.CreateDirectory(Path.GetDirectoryName(dest));
                        entry.ExtractToFile(dest, true);
                    }
                }
            }
            string launcher = Path.Combine(root,"HydraTrainStudio.exe");
            stage = "Verifying installed files";
            foreach (string required in new [] { "HydraTrainStudio.exe", "Abrir.ps1", "app/inicio.py" }) {
                string installed = Path.Combine(root, required);
                if (!File.Exists(installed) || new FileInfo(installed).Length == 0)
                    throw new IOException("Installed file is missing or empty: " + installed +
                        "\nCheck Windows Security > Protection history for a possible quarantine event.");
            }
            Record("Required application files installed successfully");
            stage = "Preparing Python and selected components";
            report(stage + ". Large model downloads can take a while.");
            string plan = Path.Combine(root, "dados", "setup-" + Guid.NewGuid().ToString("N") + ".json");
            Directory.CreateDirectory(Path.GetDirectoryName(plan));
            try {
                File.WriteAllText(plan, new System.Web.Script.Serialization.JavaScriptSerializer().Serialize(choices));
                string powershell = Path.Combine(Environment.SystemDirectory, @"WindowsPowerShell\v1.0\powershell.exe");
                var cmd = new ProcessStartInfo(powershell, "-NoProfile -ExecutionPolicy Bypass -File \"" + Path.Combine(root,"Abrir.ps1") + "\" -SetupPlan \"" + plan + "\"");
                cmd.WorkingDirectory=root;
                cmd.UseShellExecute=false;
                cmd.CreateNoWindow=true;
                cmd.EnvironmentVariables.Remove("HYDRA_DATA_DIR");
                using(var process=Process.Start(cmd)) {
                    process.WaitForExit();
                    if(process.ExitCode!=0) throw new IOException("Component setup failed. See " + Path.Combine(root,"dados","logs","setup.log"));
                }
            } finally {File.Delete(plan);}
            stage = "Creating shortcuts";
            if(choices["start"]=="True") Shortcut(Environment.GetFolderPath(Environment.SpecialFolder.Programs),root,launcher);
            if(choices["desktop"]=="True") Shortcut(Environment.GetFolderPath(Environment.SpecialFolder.DesktopDirectory),root,launcher);
            Record("Installation complete");
        } catch(Exception e) {
            Record(stage + ": " + e);
            throw new IOException(stage + "\n" + e.Message + "\nInstallation log: " + LogPath,e);
        }
        finally {
            if(temp != null) {
                try { File.Delete(temp); }
                catch (IOException e) { Record("Temporary download cleanup: " + e.Message); }
                catch (UnauthorizedAccessException e) { Record("Temporary download cleanup: " + e.Message); }
            }
        }
    }
    static void Shortcut(string folder,string root,string launcher) {
            var shell = Activator.CreateInstance(Type.GetTypeFromProgID("WScript.Shell"));
            var link = shell.GetType().InvokeMember("CreateShortcut", System.Reflection.BindingFlags.InvokeMethod, null, shell,
                new object[]{Path.Combine(folder,"HydraTrainStudio.lnk")});
            link.GetType().InvokeMember("TargetPath",System.Reflection.BindingFlags.SetProperty,null,link,new object[]{launcher});
            link.GetType().InvokeMember("WorkingDirectory",System.Reflection.BindingFlags.SetProperty,null,link,new object[]{root});
            link.GetType().InvokeMember("Save",System.Reflection.BindingFlags.InvokeMethod,null,link,null);
    }
}
